{
  "name": "datamancy",
  "version": "0.0.11",
  "description": "Cryptographically verifiable static MCP server backed by datamancy.dev — every spell content is SHA-256 verified before any prompt reaches the LLM.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./pinned-pubkey": "./dist/pinned-pubkey.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "datamancy": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CONTRACT.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "20.19.41",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "datamancy",
    "datamancer",
    "skills",
    "prompts",
    "sha256",
    "verified"
  ],
  "author": "watmin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watmin/datamancy.git"
  },
  "homepage": "https://datamancer.dev",
  "bugs": {
    "url": "https://github.com/watmin/datamancy/issues"
  }
}
